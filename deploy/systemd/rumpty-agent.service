[Unit]
Description=Rumpty guest agent
Documentation=https://github.com/Sanmo-Labs/rumpty-agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/rumpty-agent daemon
Restart=always
RestartSec=3s

# Run as root: required for AF_VSOCK binding, SSH key deployment (chown),
# hostname configuration, and startup script execution.
User=root
Group=root

# File descriptor limits.
LimitNOFILE=65536

# Restart on non-zero exits.
RestartForceExitStatus=1

# --- Hardening ---

# Allow access to /home for SSH key deployment.
ProtectHome=false

# Allow writes to /etc (hostname/hosts) and /var (startup scripts, state).
ProtectSystem=false

# Retain necessary capabilities: chown for SSH key ownership, DAC_OVERRIDE
# for file access across users, FOWNER/FSETID for permission bits.
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_FSETID CAP_SETUID CAP_SETGID

# Must be off: mkhomedir_helper is a setuid helper that needs to elevate.
NoNewPrivileges=false

# Must be off: startup scripts are written then executed by bash.
MemoryDenyWriteExecute=false

# Keep /dev/vsock accessible.
PrivateDevices=false

# Private /tmp is safe and fine.
PrivateTmp=true

# Only allow socket families needed for VSOCK claim + SSH/HTTP probing + logging.
RestrictAddressFamilies=AF_UNIX AF_VSOCK AF_INET AF_INET6

# Kernel-level protections that don't affect the claim workflow.
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectProc=invisible
RestrictNamespaces=true
LockPersonality=true
SystemCallFilter=@system-service
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
